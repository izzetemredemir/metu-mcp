# Where the SQLite database lives (default: ./var/metu.db)
METU_MCP_DB=/var/lib/metu-mcp/metu.db

# Contact address put into the scraper's User-Agent so METU admins can reach you
METU_MCP_CONTACT=you@metu.edu.tr

# Host names the HTTP endpoint answers for (DNS-rebinding protection), comma separated
METU_MCP_ALLOWED_HOSTS=mcp.example.com,localhost,127.0.0.1

# Behind a reverse proxy (Caddy): trust X-Forwarded-For for rate limiting
METU_MCP_TRUST_PROXY=1

# Tool calls per minute per client IP
METU_MCP_RATE_PER_MIN=60

# HTTP port for `metu-mcp serve`
PORT=8787
