[Unit]
Description=metu-mcp scheduled collectors (single DB writer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=metu
Group=metu
WorkingDirectory=/opt/metu-mcp
EnvironmentFile=/etc/metu-mcp.env
ExecStart=/usr/bin/node dist/cli.js worker
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/metu-mcp

[Install]
WantedBy=multi-user.target
